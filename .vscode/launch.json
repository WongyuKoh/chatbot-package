{
  // IntelliSense를 사용하여 가능한 특성에 대해 알아보세요.
  // 기존 특성에 대한 설명을 보려면 가리킵니다.
  // 자세한 내용을 보려면 https://go.microsoft.com/fwlink/?linkid=830387을(를) 방문하세요.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "example",
      "cwd": "example",
      "request": "launch",
      "type": "dart",
      // main() 위 Run/Debug 코드렌즈로 실행할 때도 이 설정(위젯 키 포함)을 쓴다.
      "templateFor": "example",
      "toolArgs": ["--dart-define-from-file=${workspaceFolder}/example/dart_defines.json"]
    },
    {
      "name": "example (profile mode)",
      "cwd": "example",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "toolArgs": ["--dart-define-from-file=${workspaceFolder}/example/dart_defines.json"]
    },
    {
      "name": "example (release mode)",
      "cwd": "example",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "toolArgs": ["--dart-define-from-file=${workspaceFolder}/example/dart_defines.json"]
    },
    {
      "name": "gist_chatbot_flutter",
      "request": "launch",
      "type": "dart",
      "toolArgs": ["--dart-define-from-file=${workspaceFolder}/example/dart_defines.json"]
    },
    {
      "name": "gist_chatbot_flutter (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "toolArgs": ["--dart-define-from-file=${workspaceFolder}/example/dart_defines.json"]
    },
    {
      "name": "gist_chatbot_flutter (release mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "toolArgs": ["--dart-define-from-file=${workspaceFolder}/example/dart_defines.json"]
    }
  ]
}
